# Copiar como .env.production y reemplazar todos los valores CAMBIAR_*.
# Este ejemplo permite una demostracion local por HTTP. Para un despliegue con
# HTTPS, activar las cookies seguras, SSL redirect y HSTS indicados al final.

# PostgreSQL
DB_NAME=global_exchange_prod
DB_USER=global_exchange_prod
DB_PASSWORD=CAMBIAR_PASSWORD_POSTGRES

# Django
DJANGO_SECRET_KEY=CAMBIAR_SECRET_KEY_ALEATORIA
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_PORT=8000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_LOG_LEVEL=INFO
DEFAULT_FROM_EMAIL=noreply@globalexchange.local

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CAMBIAR_PASSWORD_ADMIN_KEYCLOAK
KEYCLOAK_ADMIN_CLIENT_ID=global-exchange-admin-api
KEYCLOAK_ADMIN_CLIENT_SECRET=CAMBIAR_SECRET_CLIENTE_ADMIN
KEYCLOAK_PORT=8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=global-exchange
KEYCLOAK_CLIENT_ID=global-exchange-web
KEYCLOAK_EXPECTED_ISSUER=http://localhost:8080/realms/global-exchange

# URLs publicas OIDC
BACKEND_PUBLIC_URL=http://localhost:8000
OIDC_CALLBACK_URL=http://localhost:8000/callback/
OIDC_FLOW_MAX_AGE_SECONDS=600
OIDC_LOGIN_SUCCESS_URL=
OIDC_REGISTRATION_SUCCESS_URL=
OIDC_ERROR_URL=

# Cookies y transporte para la demostracion local por HTTP
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0

# En un despliegue HTTPS utilizar:
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
